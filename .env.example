# Copy this file to .env and fill in real values. Never commit .env.

# --- AI (required) ---
GEMINI_API_KEY=

# Model overrides (defaults already point at the current Gemini 3.6/3.5 line)
# VISION_MODEL_NAME=gemini-3.6-flash
# TEXT_MODEL_NAME=gemini-3.5-flash-lite
# BOOKED_MODEL_NAME=gemini-3.5-flash-lite

# --- Telegram (required to run the bot) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat/user ids. Admins can edit tariffs/operators
# and cancel any order; operators can only run the day-to-day order flow.
TELEGRAM_ADMIN_IDS=
TELEGRAM_OPERATOR_IDS=
# Optional: a chat (e.g. a private admin group) that receives WARNING+ log alerts.
TELEGRAM_LOG_CHAT_ID=
TELEGRAM_MAX_FILE_MB=20

# --- 1C data-entry automation ---
# Keep ONEC_DRY_RUN=true until an operator has confirmed the field
# navigation (FieldNav in src/onec_order_entry.py) against the real 1C
# window — dry-run only logs the actions it would take.
ONEC_DRY_RUN=true
ONEC_TEMPLATE_CONFIDENCE=0.8
ONEC_KEYSTROKE_DELAY=0.03
ONEC_ACTION_PAUSE=0.4
# Max seconds a shutdown (SIGTERM) waits for an in-flight 1C entry to
# finish before giving up anyway. Keep docker-compose's stop_grace_period
# a bit longer than this (already set to 60s in docker-compose.yml).
SHUTDOWN_GRACE_SECONDS=45

# --- RDP (read by docker/entrypoint.py, not by the Python app) ---
RDP_HOST=
RDP_USER=
RDP_DOMAIN=
# Prefer RDP_PASSWORD_FILE (a Docker secret mounted read-only) over
# RDP_PASSWORD when possible — see README "Secrets" section.
RDP_PASSWORD=
RDP_PASSWORD_FILE=
RDP_WIDTH=1920
RDP_HEIGHT=1080
# How long xfreerdp3 must stay running before .rdp_status flips to
# "connected" — a bad password / unreachable host makes it exit within a
# couple of seconds, and the 1C safety gate trusts this file.
RDP_CONNECT_GRACE_SECONDS=3
# Set to true to also expose a noVNC viewer on :6080 for watching the
# automation live (docker-compose already publishes the port).
DEBUG_VNC=false

# --- Misc ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Metrics / monitoring ---
METRICS_ENABLED=true
METRICS_PORT=9090
# Grafana admin password (http://localhost:3000, user "admin"). Change this
# before exposing Grafana beyond your own machine.
# ОБЯЗАТЕЛЬНО задать: docker compose не стартует без этого значения.
# Раньше здесь по умолчанию стоял admin, а порт 3000 публиковался наружу.
GRAFANA_ADMIN_PASSWORD=

# Интерфейсы, на которые публикуются веб-морды. По умолчанию только
# localhost — и Grafana, и noVNC показывают чувствительные данные и не имеют
# собственной защиты. Ходить через SSH-туннель:
#   ssh -L 3000:localhost:3000 -L 6080:localhost:6080 <host>
# Открыть в доверенной сети — выставить 0.0.0.0 осознанно.
GRAFANA_BIND=127.0.0.1
VNC_BIND=127.0.0.1
